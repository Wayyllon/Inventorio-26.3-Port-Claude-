            },
            {
              "condition": "fabric:not",
              "value": {
                "condition": "fabric:and",
                "values": [
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInTrades"
                  },
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInRandomSelection"
                  },
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInEnchantingTable"
                  }
                ]
              }
            }
          ]
        },
        "directory": "trades"
      },
      {
        "condition": {
          "condition": "fabric:and",
          "values": [
            {
              "condition": "inventorio:global_setting",
              "setting": "DeepPocketsInRandomSelection"
            },
            {
              "condition": "fabric:not",
              "value": {
                "condition": "fabric:and",
                "values": [
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInTrades"
                  },
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInRandomSelection"
                  },
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInEnchantingTable"
                  }
                ]
              }
            }
          ]
        },
        "directory": "random_loot"
      },
      {
        "condition": {
          "condition": "fabric:and",
          "values": [
            {
              "condition": "inventorio:global_setting",
              "setting": "DeepPocketsInEnchantingTable"
            },
            {
              "condition": "fabric:not",
              "value": {
                "condition": "fabric:and",
                "values": [
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInTrades"
                  },
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInRandomSelection"
                  },
                  {
                    "condition": "inventorio:global_setting",
                    "setting": "DeepPocketsInEnchantingTable"
                  }
                ]
              }
            }
          ]
        },
        "directory": "enchanting_table"
      }
    ]
  }
}
